+// The worked face of one stone, drawn OVER what is there (nothing is taken away): its own cast (ochre / pale / grey), the mason's
+// chisel strokes in one direction, pits, a bevelled arris (lit above and to the left, shaded below and to the right), now and then
+// a crack, a chipped corner, a stain. `k` holds the stone's own numbers (workedSeed), so the wrapped copies are identical.
+function workedSeed(w) {
+  const n = 26 + Math.floor(w() * 30);
+  return {
+    cast: w(), castA: 0.10 + w() * 0.14, ang: (w() - 0.5) * 1.2 + (w() < 0.5 ? 0.6 : -0.6),
+    strokes: Array.from({ length: n }, () => [w(), w(), 5 + w() * 9, w()]),
+    pits: Array.from({ length: 6 + Math.floor(w() * 10) }, () => [w(), w(), 0.7 + w() * 1.3]),
+    crack: w() < 0.16 ? { side: Math.floor(w() * 4), at: 0.2 + w() * 0.6, pts: Array.from({ length: 5 }, () => [0.10 + w() * 0.12, (w() - 0.5) * 0.22]) } : null,
+    chip: w() < 0.22 ? { c: Math.floor(w() * 4), a: 5 + w() * 9, b: 4 + w() * 8 } : null,
+    stain: w() < 0.14 ? [w(), w(), 16 + w() * 26, 0.10 + w() * 0.10] : null,
+    polish: [0.3 + w() * 0.4, 0.3 + w() * 0.4],
+  };
+}
+function worked(x, h, X, Y, W, H, k, inset) {
+  const x0 = X + inset, y0 = Y + inset, ww = W - 2 * inset, hh = H - 2 * inset;
+  x.save(); x.beginPath(); x.rect(x0, y0, ww, hh); x.clip();
+  h.save(); h.beginPath(); h.rect(x0, y0, ww, hh); h.clip();
+  // its own cast
+  x.fillStyle = k.cast < 0.18 ? `rgba(176,128,64,${k.castA})` : k.cast < 0.32 ? `rgba(255,250,236,${k.castA})` : k.cast < 0.44 ? `rgba(112,108,104,${k.castA})` : k.cast < 0.52 ? `rgba(196,150,120,${k.castA * 0.8})` : 'rgba(0,0,0,0)';
+  x.fillRect(x0, y0, ww, hh);
+  // dirt gathered along the joints, the middle walked smooth
+  for (const [gx0, gy0, gx1, gy1, rx, ry, rw, rh] of [[0, y0, 0, y0 + 7, x0, y0, ww, 7], [0, y0 + hh, 0, y0 + hh - 7, x0, y0 + hh - 7, ww, 7], [x0, 0, x0 + 7, 0, x0, y0, 7, hh], [x0 + ww, 0, x0 + ww - 7, 0, x0 + ww - 7, y0, 7, hh]]) {
+    const g = x.createLinearGradient(gx0, gy0, gx1, gy1); g.addColorStop(0, 'rgba(70,54,34,.20)'); g.addColorStop(1, 'rgba(70,54,34,0)'); x.fillStyle = g; x.fillRect(rx, ry, rw, rh);
+  }
+  { const gx = x0 + k.polish[0] * ww, gy = y0 + k.polish[1] * hh, rad = Math.max(ww, hh) * 0.55, g = x.createRadialGradient(gx, gy, 0, gx, gy, rad);
+    g.addColorStop(0, 'rgba(255,248,232,.13)'); g.addColorStop(1, 'rgba(255,248,232,0)'); x.fillStyle = g; x.fillRect(x0, y0, ww, hh); }
+  if (k.stain) { const [a, b, rad, al] = k.stain, gx = x0 + a * ww, gy = y0 + b * hh, g = x.createRadialGradient(gx, gy, 0, gx, gy, rad);
+    g.addColorStop(0, `rgba(86,62,36,${al})`); g.addColorStop(0.7, `rgba(86,62,36,${al * 0.5})`); g.addColorStop(1, 'rgba(86,62,36,0)'); x.fillStyle = g; x.fillRect(gx - rad, gy - rad, rad * 2, rad * 2); }
+  // chisel strokes: a dark cut with a lit lip beside it
+  const ca = Math.cos(k.ang), sa = Math.sin(k.ang);
+  x.lineCap = 'round'; h.lineCap = 'round';
+  for (const [a, b, len, t] of k.strokes) {
+    const px = x0 + a * ww, py = y0 + b * hh, dx = ca * len, dy = sa * len;
+    x.lineWidth = 1.1; x.strokeStyle = `rgba(74,58,38,${0.10 + t * 0.12})`; x.beginPath(); x.moveTo(px, py); x.lineTo(px + dx, py + dy); x.stroke();
+    x.lineWidth = 0.9; x.strokeStyle = `rgba(255,250,236,${0.10 + t * 0.10})`; x.beginPath(); x.moveTo(px - sa * 1.3, py + ca * 1.3); x.lineTo(px + dx - sa * 1.3, py + dy + ca * 1.3); x.stroke();
+    h.lineWidth = 1.4; h.strokeStyle = 'rgba(0,0,0,.22)'; h.beginPath(); h.moveTo(px, py); h.lineTo(px + dx, py + dy); h.stroke();
+  }
+  for (const [a, b, rad] of k.pits) {
