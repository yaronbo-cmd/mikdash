+  x.fillStyle = 'rgba(58,44,26,.30)'; x.fillRect(x0, y0 + hh - 1.8, ww, 1.8); x.fillStyle = 'rgba(58,44,26,.20)'; x.fillRect(x0 + ww - 1.5, y0, 1.5, hh);
+  if (k.chip) {
