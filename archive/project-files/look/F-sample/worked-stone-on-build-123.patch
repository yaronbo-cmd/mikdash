+    x.fillStyle = 'rgba(66,52,36,.34)'; x.beginPath(); x.arc(px, py, rad * 0.8, 0, 6.2832); x.fill();
+    h.fillStyle = 'rgba(0,0,0,.5)'; h.beginPath(); h.arc(px, py, rad, 0, 6.2832); h.fill();
+  }
