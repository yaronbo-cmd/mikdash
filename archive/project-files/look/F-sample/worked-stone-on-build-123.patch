 // Herodian ashlar: large blocks with drafted margins and a raised flat boss. Tile = 24 amot, 11 courses.
 export function texAshlar(seed = 7, size = 1024, tone = [38, 32, 75], rows = 11, len = [0.15, 0.36]) {
