+    const path = (c2, ox, oy) => { c2.beginPath(); c2.moveTo(P[0][0] + ox, P[0][1] + oy); for (let i = 1; i < P.length; i++) c2.lineTo(P[i][0] + ox, P[i][1] + oy); c2.stroke(); };
