+    const tri = (c2, e) => { c2.beginPath(); c2.moveTo(cx, cy); c2.lineTo(cx + sx * (a + e), cy); c2.lineTo(cx, cy + sy * (b + e)); c2.closePath(); c2.fill(); };
+    x.fillStyle = 'rgba(255,250,236,.30)'; tri(x, 1.6); x.fillStyle = 'rgba(64,50,34,.72)'; tri(x, 0);
+    h.fillStyle = 'rgba(0,0,0,.8)'; tri(h, 0);
+  }
+}
